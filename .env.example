# Copy to .env and fill in. Names must match what the code reads.

# Anthropic — text stages (1–5.5, 12–15) and Stage 19 IPA adjudication
ANTHROPIC_API_KEY=

# OpenAI — ASR roundtrip (gpt-4o-transcribe), Stage 4 validator, audio-judge candidates
OPENAI_API_KEY=

# Google Gemini — production audio judge (Stages 16, 19)
GEMINI_API_KEY=

# ElevenLabs — TTS (eleven_v4 needs the Pro tier for pcm_44100)
ELEVENLABS_API_KEY=

# Cloudflare R2 — audio hosting
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE=                  # e.g. https://pub-xxxx.r2.dev

# Azure Speech — optional, only for build/azure_pa_spike.py
SPEECH_KEY=
SPEECH_REGION=
SPEECH_ENDPOINT=
